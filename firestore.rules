rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Shared dashboards are stored encrypted: the payload is ciphertext and the
    // key never leaves the sharer's browser (it rides in the URL fragment).
    // Anything above one document is split into `parts`.
    match /shares/{shareId} {
      allow read: if true;
      // Only signed-in team members may store a link. The document holds nothing
      // but the encrypted payload (or its part count) and the encryption params.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['p', 't', 'm', 's', 'i', 'n'])
                    && request.resource.data.t is int
                    && (
                      (request.resource.data.p is string && request.resource.data.p.size() <= 900000)
                      || (request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.n <= 32)
                    )
                    && (!('m' in request.resource.data) || request.resource.data.m == 'pw');
      allow update, delete: if false;

      match /parts/{index} {
        allow read: if true;
        // Parts are written once, right after the manifest; nothing may rewrite them.
        allow create: if request.auth != null
                      && !exists(/databases/$(database)/documents/shares/$(shareId)/parts/$(index))
                      && request.resource.data.p is string
                      && request.resource.data.p.size() <= 750000
                      && request.resource.data.keys().hasOnly(['p']);
        allow update, delete: if false;
      }
    }

    // Each account's workspace (layout + rows + templates), so the same login on
    // another computer opens the same dashboard. Only the owner can read or write.
    // Big sources are split into `parts`, each kept under a comfortable size.
    match /dashboards/{uid} {
      function activeSelf() {
        return signedIn()
               && request.auth.uid == uid
               && get(/databases/$(database)/documents/users/$(uid)).data.active == true;
      }
      allow read: if activeSelf();
      allow write: if activeSelf()
                   && request.resource.data.p is string
                   && request.resource.data.p.size() <= 900000
                   && request.resource.data.keys().hasOnly(['p', 'n', 'u'])
                   && (!('n' in request.resource.data) || request.resource.data.n is int)
                   && (!('u' in request.resource.data) || request.resource.data.u is int);

      match /parts/{index} {
        allow read: if activeSelf();
        allow write: if activeSelf()
                     && request.resource.data.p is string
                     && request.resource.data.p.size() <= 750000
                     && request.resource.data.keys().hasOnly(['p']);
      }
    }

    // Team accounts. The password lives in Firebase Authentication; this record
    // only holds the profile and the approval flag.
    //
    // - anyone signed in may create their own record, but it starts blocked
    // - only an approved admin may approve, promote, disable or remove people
    // - a person may edit nothing but their own display name
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.email.size() < 200
                    && request.resource.data.name is string
                    && request.resource.data.createdAt is int
                    && (
                      // Normal sign-up: blocked until an admin approves it.
                      request.resource.data.role == 'member'
                      && request.resource.data.active == false
                      && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'active', 'createdAt'])
                    );

      allow update: if isAdmin()
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    );

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
