rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared dashboards are stored encrypted: the payload is ciphertext and the
    // key never leaves the sharer's browser (it rides in the URL fragment).
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.resource.data.p is string
                    && request.resource.data.p.size() <= 900000;
      allow update, delete: if false;
    }
    // Team accounts. Passwords are stored only as PBKDF2 hashes (310k rounds,
    // per-user salt), never in clear text. The app signs people in and decides
    // who is an admin; these rules only keep the shape of the records sane.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.salt is string
                    && request.resource.data.hash is string
                    && request.resource.data.hash.size() < 200;
      allow update: if request.resource.data.hash is string
                    && request.resource.data.salt is string;
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
