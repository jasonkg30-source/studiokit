rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Shared dashboards are stored encrypted: the payload is ciphertext and the
    // key never leaves the sharer's browser (it rides in the URL fragment).
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.resource.data.p is string
                    && request.resource.data.p.size() <= 900000;
      allow update, delete: if false;
    }

    // Team accounts. The password lives in Firebase Authentication; this record
    // only holds the profile and the approval flag.
    //
    // - anyone signed in may create their own record, but it starts blocked
    // - only an approved admin may approve, promote, disable or remove people
    // - a person may edit nothing but their own display name
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.email.size() < 200
                    && request.resource.data.name is string
                    && request.resource.data.createdAt is int
                    && (
                      // Normal sign-up: blocked until an admin approves it.
                      (
                        request.resource.data.role == 'member'
                        && request.resource.data.active == false
                        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'active', 'createdAt'])
                      )
                      ||
                      // One-time owner bootstrap. This clause is removed right
                      // after the first account exists.
                      (
                        request.resource.data.bootstrap == 'sk9f2c41b7e0'
                        && request.resource.data.role == 'owner'
                        && request.resource.data.active == true
                        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'active', 'createdAt', 'bootstrap'])
                      )
                    );

      allow update: if isAdmin()
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    );

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
