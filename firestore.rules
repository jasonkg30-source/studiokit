rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Shared dashboards are stored encrypted: the payload is ciphertext and the
    // key never leaves the sharer's browser (it rides in the URL fragment).
    // Anything above one document is split into `parts`.
    match /shares/{shareId} {
      function self() {
        return signedIn() && request.auth.uid == resource.data.o;
      }
      function notExpired() {
        return !('e' in resource.data) || resource.data.e > request.time.toMillis();
      }

      // Anyone with the link may read an active share; the owner may always read
      // their own, even after it expired, so it can still be renamed or deleted.
      allow get: if self() || notExpired();
      // "My links" only ever queries by owner, which is what makes this provable.
      allow list: if signedIn()
                   && request.query.limit <= 200
                   && request.auth.uid == resource.data.o;

      // Only signed-in team members may store a link. The document holds nothing
      // but the encrypted payload (or its part count), the encryption params and
      // who owns it.
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['p', 't', 'm', 's', 'i', 'n', 'o', 'l', 'e'])
                    && request.resource.data.o == request.auth.uid
                    && request.resource.data.t is int
                    && (
                      (request.resource.data.p is string && request.resource.data.p.size() <= 900000)
                      || (request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.n <= 32)
                    )
                    && (!('m' in request.resource.data) || request.resource.data.m == 'pw')
                    && (!('l' in request.resource.data)
                        || (request.resource.data.l is string && request.resource.data.l.size() <= 80))
                    && (!('e' in request.resource.data) || request.resource.data.e is int);

      // The ciphertext is immutable; only the label and the expiry can change.
      allow update: if self()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['l', 'e'])
                    && (!('l' in request.resource.data)
                        || (request.resource.data.l is string && request.resource.data.l.size() <= 80))
                    && (!('e' in request.resource.data) || request.resource.data.e is int);

      allow delete: if self();

      match /parts/{index} {
        function owner() {
          return signedIn() && get(/databases/$(database)/documents/shares/$(shareId)).data.o == request.auth.uid;
        }
        function active() {
          return !('e' in get(/databases/$(database)/documents/shares/$(shareId)).data)
                 || get(/databases/$(database)/documents/shares/$(shareId)).data.e > request.time.toMillis();
        }

        allow get: if owner() || active();
        // Parts are written once, right after the manifest, by the same owner.
        allow create: if owner()
                      && !exists(/databases/$(database)/documents/shares/$(shareId)/parts/$(index))
                      && request.resource.data.p is string
                      && request.resource.data.p.size() <= 750000
                      && request.resource.data.keys().hasOnly(['p']);
        // Deleting a link removes its parts first, so this is the normal path.
        allow delete: if owner();
        allow update: if false;
      }
    }

    // Each account's workspace (layout + rows + templates), so the same login on
    // another computer opens the same dashboard. Only the owner can read or write.
    // Big sources are split into `parts`, each kept under a comfortable size.
    match /dashboards/{uid} {
      function activeSelf() {
        return signedIn()
               && request.auth.uid == uid
               && get(/databases/$(database)/documents/users/$(uid)).data.active == true;
      }
      allow read: if activeSelf();
      allow write: if activeSelf()
                   && request.resource.data.p is string
                   && request.resource.data.p.size() <= 900000
                   && request.resource.data.keys().hasOnly(['p', 'n', 'u'])
                   && (!('n' in request.resource.data) || request.resource.data.n is int)
                   && (!('u' in request.resource.data) || request.resource.data.u is int);

      match /parts/{index} {
        allow read: if activeSelf();
        allow write: if activeSelf()
                     && request.resource.data.p is string
                     && request.resource.data.p.size() <= 750000
                     && request.resource.data.keys().hasOnly(['p']);
      }
    }

    // Team accounts. The password lives in Firebase Authentication; this record
    // only holds the profile and the approval flag.
    //
    // - anyone signed in may create their own record, but it starts blocked
    // - only an approved admin may approve, promote, disable or remove people
    // - a person may edit nothing but their own display name
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.email.size() < 200
                    && request.resource.data.name is string
                    && request.resource.data.createdAt is int
                    && (
                      // Normal sign-up: blocked until an admin approves it.
                      request.resource.data.role == 'member'
                      && request.resource.data.active == false
                      && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'active', 'createdAt'])
                    );

      allow update: if isAdmin()
                    || (
                      signedIn()
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    );

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
